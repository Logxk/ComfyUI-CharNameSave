__pycache__/
*.pyc

# 测试源码不进仓库（使用者拿到插件即可用，不需要跑测试）。
# 本地保留 tests/ 目录，只是不被 git 跟踪；下面几条是它运行时产生的临时目录。
tests/
tests/_tmp_output/
tests/_tmp_bare/
tests/_tmp_load/
tests/_tmp_multi/
tests/_tmp_hardening/
tests/_tmp_download/

# 数据集与下载缓存：
# - data/characters.jsonl **随仓库分发**（快照 2026-09-18，22,474 条 / 约 2.1 MB），
#   这样使用者下载插件后无需联网即可使用「无作品名角色识别」；需要更新时再跑
#   download_dataset.py 覆盖它。
# - data/characters.jsonl.meta 记录远端标识，只对本机增量判断有意义，不入库。
# - .hf_cache/ 保存下载到的原始文件（约 9 MB，可删），不入库。
# 下载脚本统一使用 .hf_cache/；.hfcache/ 只是历史遗留的临时目录名，仍一并忽略。
# 注意：data/ 下不要写 `data/` 或 `data/*` 这类整体忽略规则，否则会把快照数据文件挡掉。
data/characters.jsonl.meta
.hf_cache/
.hfcache/
