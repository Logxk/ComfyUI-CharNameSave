__pycache__/
*.pyc
# 测试运行时在 tests/ 下创建的临时目录（用例结束会自动清理，这里防止中断后留下垃圾）
tests/_tmp_output/
tests/_tmp_bare/
tests/_tmp_load/
tests/_tmp_multi/
tests/_tmp_hardening/
tests/_tmp_download/

# 数据集与下载缓存：
# - data/characters.jsonl 由 download_dataset.py 生成（约 2 MB），也可手动放入
# - data/characters.jsonl.meta 记录远端标识，供增量更新判断
# - .hf_cache/ 保存下载到的原始文件（约 9 MB，可删）
# 下载脚本统一使用 .hf_cache/；.hfcache/ 只是历史遗留的临时目录名，仍一并忽略。
.hf_cache/
.hfcache/
data/characters.jsonl
data/characters.jsonl.meta
